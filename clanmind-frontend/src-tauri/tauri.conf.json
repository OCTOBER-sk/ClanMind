{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClanMind",
  "version": "0.1.0",
  "identifier": "io.clanmind.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClanMind",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "lEPXGdYuqL/o2x4fX4F5dCqoWdVl1+LeOKHgQJ299f5JXm3hRQP/w0f5DSJgovtFjFwJgPQN6L1h+eA0TWghKw==",
      "endpoints": ["https://updates.clanmind.io/{{target}}/{{arch}}/{{current_version}}"]
    }
  }
}