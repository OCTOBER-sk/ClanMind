# ClanMind backend environment configuration (spec §162)
# Copy to .env for local development. NEVER commit real values (§162/§164).
# local / staging / production must use separate values; never production
# provider secrets in local development.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Service-role key: privileged connection used ONLY by the Worker service
# layer (§87A "direct-access vs service-layer boundary"). Never exposed to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Local Postgres connection string for integration tests / migrations
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- R2 ---
R2_BUCKET_NAME=clanmind-shared-objects

# --- JWT/auth ---
# Supabase JWT signing secret (for verifying access tokens in the auth gateway)
SUPABASE_JWT_SECRET=

# --- AI application providers (platform keys, not BYOK) ---
APP_PROVIDER_OPENAI_KEY=
APP_PROVIDER_ANTHROPIC_KEY=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# --- Search providers ---
TAVILY_API_KEY=
EXA_API_KEY=

# --- Secret encryption (BYOK envelope encryption, §63.2) ---
SECRET_ENCRYPTION_KEY=

# --- Logging ---
LOG_LEVEL=info
