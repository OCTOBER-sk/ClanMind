{
  "name": "clanmind-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "ClanMind backend — Cloudflare Workers modular monolith per the Master Implementation Specification",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @clanmind/worker dev",
    "deploy": "pnpm --filter @clanmind/worker deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
